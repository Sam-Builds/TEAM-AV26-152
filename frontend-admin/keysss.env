# ─────────────────────────────────────────────────────────────────────────────
# DisasterScope — API Keys & Secrets
# Copy this file to keysss.env and fill in your values.
# NEVER commit the filled file to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Twitter / X  (https://developer.twitter.com → Bearer Token) ──────────────
TWITTER_BEARER_TOKEN=

# ── NewsData.io  (https://newsdata.io → API Key) ─────────────────────────────
NEWSDATA_API_KEY=

# ── NewsAPI.org  (https://newsapi.org → API Key) ─────────────────────────────
NEWSAPI_KEY=

# ── OpenAI  (https://platform.openai.com → API Keys)  ────────────────────────
# Used by ensemble_engine to generate GPT-4o-mini situation briefs.
# Leave blank to use the built-in template fallback (no API needed).
OPENAI_API_KEY=

# ── Facebook Page  (https://developers.facebook.com) ─────────────────────────
# Requires: pages_read_engagement permission + Page Access Token
FB_PAGE_TOKEN=
FB_PAGE_ID=

# ── Instagram Business  (https://developers.facebook.com) ────────────────────
# Requires: instagram_basic permission + long-lived User Access Token
IG_USER_TOKEN=
IG_USER_ID=

# ── Threads  (https://developers.facebook.com/docs/threads) ──────────────────
THREADS_TOKEN=
THREADS_USER_ID=
